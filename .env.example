# ============================================================
# RADS Emergency Email Dispatch Configuration
# ============================================================
# Copy these settings to your system environment variables
# OR create a .env file and load with python-decouple / dotenv.
# NEVER commit actual passwords to source control.
#
# Gmail App Password Setup:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Under "App passwords", generate one for "Mail"
#   4. Paste the 16-char app password as EMAIL_HOST_PASSWORD below
#
# To set on Windows (PowerShell, current session only):
#   $env:EMAIL_HOST_USER="youraddress@gmail.com"
#   $env:EMAIL_HOST_PASSWORD="your-16-char-app-password"
#
# To set permanently on Windows:
#   [System.Environment]::SetEnvironmentVariable("EMAIL_HOST_USER","youraddress@gmail.com","User")
#   [System.Environment]::SetEnvironmentVariable("EMAIL_HOST_PASSWORD","your-app-password","User")
# ============================================================

# Required for Gmail SMTP
EMAIL_HOST_USER=your_sender_address@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

# Optional overrides (defaults are already set in settings.py)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RADS Emergency System <your_sender_address@gmail.com>

# ============================================================
# To test WITHOUT a real email server (development only):
# Set this to use Django's in-memory mail backend:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# This prints emails to the console instead of sending them.
# dispatch_status will show "Failed" because console backend
# returns 0 sent count -- use locmem or smtp for real testing.
# ============================================================
